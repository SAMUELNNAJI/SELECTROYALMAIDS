# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-domain.com

# ZeptoMail SMTP: use the SMTP token from the selected ZeptoMail agent.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zeptomail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=emailapikey
EMAIL_HOST_PASSWORD=replace-with-your-zeptomail-smtp-token
DEFAULT_FROM_EMAIL=info@your-verified-domain.com
SITE_URL=https://your-domain.com

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-secret-key-X
FLUTTERWAVE_ENCRYPT_KEY=your-encryption-key
