# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to version control.

# Django
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1

# Database
# Leave blank to use SQLite locally.
# On Render this is auto-set to the Postgres connection string.
DATABASE_URL=

# Paystack (get keys from https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email backend
# Use console for local dev; swap for SMTP in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
