# ──────────────────────────────────────────────────────────────────────────────
# SelectRoyal Maids — production environment (AlmaLinux VPS)
# Copy this to /etc/selectroyal/selectroyal.env and fill in real values.
#   sudo install -m 640 -o root -g selectroyal selectroyal.env.example \
#       /etc/selectroyal/selectroyal.env
# Permissions: root:selectroyal, mode 640 so secret values are readable only
# by the site account and root.
# ──────────────────────────────────────────────────────────────────────────────

# Django core
SECRET_KEY=CHANGE_ME_generate_with_python_-c_"import secrets;print(secrets.token_urlsafe(50))"
DEBUG=False
# Space-separated, include your domain and the server's public IP / hostname
ALLOWED_HOSTS=selectroyalmaids.com.ng www.selectroyalmaids.com.ng your-server-ip

# Database — set your Postgres URL (Neon / local / managed). If left empty the
# site falls back to SQLite at /srv/selectroyal/db.sqlite3.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/selectroyal?sslmode=require

# Email (ZeptoMail or your SMTP provider)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zeptomail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=emailapikey
EMAIL_HOST_PASSWORD=REPLACE_WITH_EMAIL_API_KEY
DEFAULT_FROM_EMAIL=info@selectroyalmaids.com.ng
EMAIL_TIMEOUT=10

# Company inbox that receives new "Request a Maid" placements + notifications
NOTIFICATION_EMAIL=info@selectroyalmaids.com.ng

# Absolute public URL of the site (no trailing slash)
SITE_URL=https://selectroyalmaids.com.ng
PAYMENT_CALLBACK_URL=https://selectroyalmaids.com.ng

# Flutterwave (live keys for production)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPT_KEY=FLWSECK-xxxxxxxxxxxxxxxx

# WhatsApp Business Cloud API — new Maid registration forms are delivered here
# as WhatsApp text messages. Fill in the token + Phone Number ID to enable.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APPLICATION_RECIPIENT=2349137894958   # +234 913 789 4958